// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 사용자 테이블 (직원 정보)
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  employeeId  String   @unique
  department  String
  position    String?
  lineTeam    String?
  isActive    Boolean  @default(true)
  isInstructor Boolean @default(false)
  isAdmin     Boolean  @default(false)
  roles       String[] // JSON 배열로 저장
  koreanEnglishGrade String?
  koreanEnglishExpiry String?
  japaneseGrade String?
  chineseGrade String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 관계
  evaluations Evaluation[]
  requests    Request[]
  loginLogs   LoginLog[]
  scheduleApplications ScheduleApplication[]
  educationCheckins EducationCheckin[]
  recordingCheckins RecordingCheckin[]

  @@map("users")
}

// 평가 테이블
model Evaluation {
  id              String   @id @default(cuid())
  userId          String
  language        String   // 'korean-english', 'japanese', 'chinese'
  category        String   // '신규', '재자격', '공통', 'PUS'
  status          String   @default("pending") // 'pending', 'review_requested', 'completed', 'approved', 'deleted', 're_evaluation'
  submittedAt     DateTime @default(now())
  evaluatedAt     DateTime?
  evaluatedBy     String?  // 최종 평가자 (마지막으로 평가한 교관)
  initialEvaluatedAt DateTime? // 최초 평가 시간
  initialEvaluatedBy String?   // 최초 평가자 (처음 평가한 교관, 교관 통계용)
  totalScore      Float    @default(0)
  koreanTotalScore Float   @default(0)
  englishTotalScore Float  @default(0)
  grade           String   @default("N/A")
  comments        Json?    // { korean: string, english: string }
  approved        Boolean  @default(false)
  approvedAt      DateTime?
  approvedBy      String?
  reviewRequestedAt DateTime?
  reviewRequestedBy String?
  reevaluatedAt   DateTime?
  reevaluatedBy   String?
  deletedAt       DateTime?
  deletedBy       String?
  recordingCount  Int?
  scriptNumbers   Int[]    // JSON 배열로 저장
  comment         String?
  duration        Int      @default(0)
  isFileUpload    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 관계
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores          EvaluationScore[]
  recordings      Recording[]

  @@map("evaluations")
}

// 평가 점수 테이블
model EvaluationScore {
  id           String @id @default(cuid())
  evaluationId String
  criteriaKey  String // 예: 'korean-pronunciation', 'english-fluency'
  score        Float
  language     String? // 'korean', 'english', 'japanese', 'chinese'
  createdAt    DateTime @default(now())

  // 관계
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criteriaKey, language])
  @@map("evaluation_scores")
}

// 녹음 파일 테이블
model Recording {
  id           String @id @default(cuid())
  evaluationId String
  scriptNumber Int
  language     String // 'korean', 'english', 'japanese', 'chinese'
  filePath     String
  fileName     String
  fileSize     Int?
  originalFileName String?
  url          String?
  dropboxPath  String?
  dropboxFileId String?
  fileData     String? // Base64 인코딩된 파일 데이터
  success      Boolean @default(true)
  createdAt    DateTime @default(now())

  // 관계
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, scriptNumber, language])
  @@map("recordings")
}

// 신청 테이블 (교육/녹음 신청)
model Request {
  id              String   @id @default(cuid())
  userId          String
  type            String   // 'education', 'recording'
  date            String   // YYYY-MM-DD
  slot            Int
  details         Json     // 상세 정보 (언어, 모드, 카테고리 등)
  status          String   @default("ACTIVE") // 'ACTIVE', 'CANCELED'
  notes           String?
  canceledTime    DateTime?
  applicationTime DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 관계
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("requests")
}

// 로그인 로그 테이블
model LoginLog {
  id           String @id @default(cuid())
  userId       String?
  email        String
  name         String
  employeeId   String?
  department   String?
  loginTime    DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  loginMethod  String // 'google', 'workspace', 'test'
  success      Boolean @default(true)
  errorMessage String?

  // 관계
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("login_logs")
}

// 월별 스케줄 데이터 (Google Sheets에서 동기화)
model MonthlySchedule {
  id          String   @id @default(cuid())
  month       String   @unique // "YYYY-MM" format
  schedules   Json     // 스케줄 배열 데이터
  sheetData   Json?    // 원본 Google Sheets 데이터 보존
  active      Boolean  @default(true) // 스케줄 활성화 상태 (request 모드 노출 여부)
  syncedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("monthly_schedules")
}

// 개별 스케줄 (정규화된 형태)
model Schedule {
  id          String   @id @default(cuid())
  month       String   // "YYYY-MM"
  date        String   // "YYYY-MM-DD"
  type        String   // "korean-english" | "japanese" | "chinese"
  classType   String   // "1:1" | "small"
  category    String   @default("공통") // "신규" | "재자격" | "공통" | "PUS"
  slots       Json     // [1, 2, 3, 4] - 개설된 슬롯 배열
  capacity    Int      // 슬롯당 최대 인원
  classroom   String?  // "5A" 등
  visible     Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 관계
  applications ScheduleApplication[]

  @@unique([date, type, classType, category]) // 카테고리별 중복 방지
  @@index([month])
  @@index([date, type])
  @@index([category])
  @@map("schedules")
}

// 스케줄 신청 내역
model ScheduleApplication {
  id         String   @id @default(cuid())
  scheduleId String
  employeeId String
  slot       Int      // 1-8
  status     String   @default("ACTIVE") // "ACTIVE" | "CANCELED"
  details    Json?    // 추가 신청 정보
  
  appliedAt  DateTime @default(now())
  canceledAt DateTime?
  
  // 관계
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [employeeId], references: [employeeId])

  // @@unique([scheduleId, employeeId, slot, status]) // 임시로 제거 - 같은 슬롯에 여러 언어 신청 허용
  @@index([employeeId])
  @@index([scheduleId, slot])
  @@map("schedule_applications")
}

// 교육 체크인 테이블
model EducationCheckin {
  id           String   @id @default(cuid())
  requestId    String   // Request 테이블의 ID
  employeeId   String   // 체크인한 직원 ID
  checkinTime  DateTime // 체크인 시간
  status       String   @default("CHECKED_IN") // "CHECKED_IN", "COMPLETED", "NO_SHOW"
  notes        String?  // 체크인 관련 메모
  ipAddress    String?  // 체크인한 IP 주소
  location     String?  // 체크인 위치 (GPS 좌표 등)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 관계
  user         User     @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@unique([requestId, employeeId]) // 같은 요청에 대해 한 번만 체크인 가능
  @@index([employeeId])
  @@index([requestId])
  @@index([checkinTime])
  @@map("education_checkins")
}

// 녹음 체크인 테이블
model RecordingCheckin {
  id           String   @id @default(cuid())
  employeeId   String   // 체크인한 직원 ID
  name         String   // 직원 이름
  language     String   // 녹음 언어 ('korean-english', 'japanese', 'chinese')
  category     String   // 평가 구분 ('신규', '재자격', '공통', 'PUS')
  checkinDate  DateTime // 체크인 시간
  status       String   @default("CHECKED_IN") // "CHECKED_IN", "RECORDING_STARTED", "COMPLETED"
  notes        String?  // 체크인 관련 메모
  ipAddress    String?  // 체크인한 IP 주소
  location     String?  // 체크인 위치 (GPS 좌표 등)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 관계
  user         User     @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@index([employeeId])
  @@index([checkinDate])
  @@index([language])
  @@map("recording_checkins")
}

// PDF 문안 파일 테이블
model PdfScript {
  id           String   @id @default(cuid())
  language     String   // 'korean-english', 'japanese', 'chinese'
  scriptNumber Int      // 문안 번호 (1, 2, 3, ...)
  fileName     String   // 원본 파일명 (예: "한영_문안1.pdf")
  fileData     Bytes    // PDF 파일 바이너리 데이터
  fileSize     Int      // 파일 크기 (bytes)
  mimeType     String   @default("application/pdf")
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // 메타데이터
  checksum     String?  // 파일 무결성 검증용 해시
  version      Int      @default(1) // 파일 버전 (덮어쓰기 시 증가)
  
  @@unique([language, scriptNumber]) // 언어별 문안 번호는 유일해야 함
  @@index([language])
  @@index([scriptNumber])
  @@map("pdf_scripts")
}

// 교육 일지 테이블
model EducationJournal {
  id                    String   @id @default(cuid())
  educationSessionId    String?  // 교육 세션 ID (선택적)
  traineeEmployeeId     String   // 교육생 사번
  traineeName           String   // 교육생 이름
  instructorEmployeeId  String   // 교관 사번
  instructorName        String   // 교관 이름
  educationDate         DateTime // 교육 날짜
  educationType         String   // '1:1', 'small-group'
  educationLanguage     String   // 'korean-english', 'japanese', 'chinese'
  educationSlot         Int      // 교육 차수
  contentCategories     String[] // 교육 내용 카테고리 배열
  detailedContent       String   // 세부 교육 내용
  feedback              String?  // 피드백
  rating                Int?     // 1-5 평점
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([traineeEmployeeId])
  @@index([instructorEmployeeId])
  @@index([educationDate])
  @@map("education_journals")
}


