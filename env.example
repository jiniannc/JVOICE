# Railway Database
DATABASE_URL="postgresql://username:password@host:port/database"

# NextAuth
NEXTAUTH_URL="https://your-app.railway.app"
NEXTAUTH_SECRET="your-secret-key"

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google API
NEXT_PUBLIC_GOOGLE_API_KEY="your-google-api-key"

# Google Service Account (for Calendar API)
GOOGLE_PROJECT_ID="your-google-project-id"
GOOGLE_PRIVATE_KEY_ID="your-google-private-key-id"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-google-private-key\n-----END PRIVATE KEY-----"
GOOGLE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_CLIENT_ID="your-google-client-id-number"

# Google Sheets
NEXT_PUBLIC_EMPLOYEE_SPREADSHEET_ID="your-spreadsheet-id"
NEXT_PUBLIC_EDU_APP_SHEET_ID="your-education-sheet-id"
NEXT_PUBLIC_REC_APP_SHEET_ID="your-recording-sheet-id"

# Google Drive
NEXT_PUBLIC_SCRIPTS_FOLDER_ID="your-scripts-folder-id"
NEXT_PUBLIC_RECORDINGS_FOLDER_ID="your-recordings-folder-id"

# Dropbox (마이그레이션 중에만 사용)
DROPBOX_APP_KEY="your-dropbox-app-key"
DROPBOX_APP_SECRET="your-dropbox-app-secret"
DROPBOX_REFRESH_TOKEN="your-dropbox-refresh-token"

# WebSocket
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# Admin
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
DEFAULT_INSTRUCTOR_USERNAME="instructor"
DEFAULT_INSTRUCTOR_PASSWORD="eval123"

# Email Service (for cancellation notifications)
EMAIL_SERVICE_TYPE="company" # gmail, workspace, company, sendgrid, simulation
EMAIL_FROM="noreply@jinair.com"
EMAIL_FROM_NAME="객실기내방송팀"

# Gmail SMTP (for personal Gmail accounts)
EMAIL_GMAIL_USER="your-gmail@gmail.com"
EMAIL_GMAIL_PASSWORD="your-app-password"

# Google Workspace SMTP (for company accounts)
# EMAIL_GMAIL_USER="your-email@yourcompany.com"
# EMAIL_GMAIL_PASSWORD="your-app-password"

# Company SMTP Server (bypasses SendGrid blocks)
COMPANY_SMTP_HOST="mail.jinair.com"
COMPANY_SMTP_PORT="587"
COMPANY_SMTP_USER="your-email@jinair.com"

# 옵션 1: 앱 비밀번호 사용 (추천)
COMPANY_SMTP_PASSWORD="app-specific-password"  # 개인 비밀번호가 아닌 앱 비밀번호

# 옵션 2: OAuth 2.0 사용 (가장 안전)
COMPANY_OAUTH_CLIENT_ID="your-oauth-client-id"
COMPANY_OAUTH_CLIENT_SECRET="your-oauth-client-secret"
COMPANY_OAUTH_REFRESH_TOKEN="your-refresh-token"
COMPANY_OAUTH_ACCESS_TOKEN="your-access-token"

# SendGrid (if using SendGrid)
SENDGRID_API_KEY="your-sendgrid-api-key"
